{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "admin-console/ApprovalRequest.schema.json",
  "title": "ApprovalRequest",
  "description": "POST /v1/approvals 본문(I5 decide). 만드는 쪽: admin-console. 읽는 쪽: release-gate. GateApproval에서 서버가 정하는 approval_id, decided_at, approver_id를 뺀 것에 report_hash를 더한다. approver_id는 보내지 않는다(X-Openit-User가 유일한 길, HTTP.md I5·D88). Id/Hash 패턴은 _common.schema.json과 같다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "submission_id",
    "decision",
    "approver_role",
    "report_hash"
  ],
  "properties": {
    "submission_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "decision": {
      "enum": [
        "APPROVE",
        "REJECT"
      ]
    },
    "approver_role": {
      "type": "string",
      "const": "release-approver"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "description": "반려에는 필수"
    },
    "report_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "GET review-report 응답 헤더 X-Openit-Report-Hash를 그대로 돌려준 값. 화면은 계산하지 않는다"
    }
  },
  "if": {
    "properties": {
      "decision": {
        "const": "REJECT"
      }
    },
    "required": [
      "decision"
    ]
  },
  "then": {
    "required": [
      "reason"
    ]
  }
}
