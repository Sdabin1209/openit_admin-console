{
  "schema_version": 1,
  "image": "admin-console",
  "read_only_root": true,
  "exec_absolute_argv": true,
  "role_env": null,
  "roles": {
    "default": {
      "env_schema": "AdminConsoleEnv",
      "process": {
        "uid": 65532,
        "gid": 65532
      },
      "files": [
        {
          "path_env": null,
          "path": "/etc/openit/pki",
          "directory": true,
          "kind": "certificate",
          "schema": null,
          "required": true,
          "opened_by": "start-process"
        }
      ],
      "writable": [
        {
          "path": "/tmp",
          "persist": false,
          "written_by": {
            "uid": 65532,
            "gid": 65532
          }
        }
      ],
      "capabilities": [
        "NET_BIND_SERVICE"
      ],
      "sysctls": {}
    }
  },
  "jobs": {}
}
