{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ReleaseRow.schema.json",
  "title": "ReleaseRow",
  "description": "릴리스 목록의 한 줄(ReleaseManifest의 읽기용 투영). 문진표는 question_sets 목록이다(계약 3.3.0).",
  "type": "object",
  "required": [
    "release_id",
    "created_at",
    "gate_decision_id"
  ],
  "properties": {
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "gate_decision_id": {
      "type": "string"
    },
    "lora_a": {
      "$ref": "ArtifactRefRow.schema.json"
    },
    "lora_b": {
      "$ref": "ArtifactRefRow.schema.json"
    },
    "question_sets": {
      "type": "array",
      "items": {
        "$ref": "QuestionSetRef.schema.json"
      }
    }
  }
}
