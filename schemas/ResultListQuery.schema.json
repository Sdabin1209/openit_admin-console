    "status": {
      "type": "string"
    },
    "updated_after": {
      "type": "string"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "cursor": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
