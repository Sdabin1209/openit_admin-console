{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ApprovalDecision.schema.json",
  "title": "ApprovalDecision",
  "description": "approval_draft의 출력이자 approval_confirm의 입력·출력이며 link_gate_decide의 입력: 보내도 되는 결정. REJECT면 사유가 있고 APPROVE에는 사유가 없다.",
  "type": "object",
  "required": [
    "submissionId",
    "decision",
    "reportHash"
  ],
  "properties": {
    "submissionId": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "APPROVE",
        "REJECT"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "reportHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "REJECT"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "APPROVE"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "not": {
          "required": [
            "reason"
          ]
        }
      }
    }
  ]
}
