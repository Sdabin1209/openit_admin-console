{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PointerRecord.schema.json",
  "title": "PointerRecord",
  "description": "활성 포인터(ActivePointer의 읽기용 투영). cause의 모르는 값을 받는다. 행위자 필드는 계약에 없다(CR-004).",
  "type": "object",
  "required": [
    "release_id",
    "pointer_version",
    "activated_at",
    "cause"
  ],
  "properties": {
    "pipeline_schema_version": {
      "type": "string"
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "pointer_version": {
      "type": "integer"
    },
    "activated_at": {
      "type": "string"
    },
    "cause": {
      "type": "string"
    },
    "ext": {
      "type": "object"
    }
  }
}
