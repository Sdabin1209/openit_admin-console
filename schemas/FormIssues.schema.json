{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "FormIssues.schema.json",
  "title": "FormIssues",
  "description": "입력 폼 컴포넌트(approval_draft, case_review_draft, ops_request)가 입력을 거부할 때 내는 목록. path는 입력 스키마 안의 위치, message는 화면에 보일 한국어.",
  "type": "object",
  "required": [
    "issues"
  ],
  "properties": {
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "message"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
