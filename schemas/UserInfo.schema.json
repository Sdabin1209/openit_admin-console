{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "UserInfo.schema.json",
  "title": "UserInfo",
  "description": "oauth2-proxy `GET /oauth2/userinfo`의 응답 중 화면이 읽는 부분(읽기용 투영). 모르는 필드는 받는다. groups는 Keycloak 그룹 = 역할 이름(ADR 0014 결정 2).",
  "type": "object",
  "properties": {
    "user": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "preferredUsername": {
      "type": "string"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
