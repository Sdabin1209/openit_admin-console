{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ArtifactRef.schema.json",
  "title": "ArtifactRef",
  "description": "산출물 참조(문항 세트·LoRA). 화면은 id와 version만 보이고 모르는 필드는 보존한다.",
  "type": "object",
  "required": [
    "id",
    "version",
    "content_hash"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "content_hash": {
      "type": "string"
    }
  }
}
