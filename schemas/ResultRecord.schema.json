{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ResultRecord.schema.json",
  "title": "ResultRecord",
  "description": "문진 결과 한 세션(문진 스키마 SessionResult의 읽기용 투영). status와 reason은 모르는 값도 받는다. acknowledged_by/at은 확인 표시 뒤에 채워진다(없거나 null이면 미확인). 모르는 필드는 받는다.",
  "type": "object",
  "required": [
    "session_id",
    "status",
    "answers",
    "skipped_details"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "ended_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "release_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "question_bank_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "value",
          "status"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string"
          },
          "precision": {
            "type": "string"
          },
          "value": {}
        }
      }
    },
    "skipped_details": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item",
          "reason"
        ],
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1
          },
          "slot": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acknowledged_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "acknowledged_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
