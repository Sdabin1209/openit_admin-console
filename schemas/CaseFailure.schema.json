{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CaseFailure.schema.json",
  "title": "CaseFailure",
  "description": "case_failure의 출력. back_to_case는 사례 화면에 알림을 보이고 머문다, fail은 오류 화면(또는 trace 오류 문구).",
  "type": "object",
  "required": [
    "action"
  ],
  "properties": {
    "action": {
      "enum": [
        "back_to_case",
        "fail"
      ]
    },
    "notice": {
      "type": "object",
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "enum": [
            "invalid",
            "denied",
            "retry",
            "notfound"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "errorText": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "fail"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "errorText"
        ]
      },
      "else": {
        "required": [
          "notice"
        ]
      }
    }
  ]
}
