{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TimeText.schema.json",
  "title": "TimeText",
  "description": "time_display의 출력: 원문을 그대로 두고 괄호 안에 현지 시각을 덧붙인 글. 해석할 수 없으면 원문만, 없으면 대시.",
  "type": "object",
  "required": [
    "text"
  ],
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
