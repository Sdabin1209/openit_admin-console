{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ApprovalConfirmInput.schema.json",
  "title": "ApprovalConfirmInput",
  "description": "approval_confirm의 입력: 확인창에서 승인자가 입력한 글자와 보내려는 결정. 확정하려면 입력이 제출 ID와 같아야 한다(ADR 0014, 이 필드 간 같음은 스키마 밖 조건).",
  "type": "object",
  "required": [
    "decision",
    "confirmText"
  ],
  "properties": {
    "decision": {
      "$ref": "ApprovalDecision.schema.json"
    },
    "confirmText": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
