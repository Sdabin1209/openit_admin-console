{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ResultPage.schema.json",
  "title": "ResultPage",
  "description": "link_result_list의 출력: 한 쪽의 결과 목록(최신부터)과 다음 쪽 커서.",
  "type": "object",
  "required": [
    "items",
    "next_cursor"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "ResultRecord.schema.json"
      }
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
