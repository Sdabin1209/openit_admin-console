# 정적 파일 서버 설정(ADR 0018, ADR 0006 대체). 동작은 직접 만든 Node 서버와 같다: tests/static-behavior.test.ts가 고정한다.
# /v1은 처리하지 않는다(같은 출처의 게이트웨이가 프록시한다).
{
	# 왜: 관리 API(:2019)는 이 이미지에 필요 없고 열어 두면 공격면이 된다. 인증서·ACME도 없다(TLS는 게이트웨이 몫).
	admin off
	auto_https off
	persist_config off
}

# 왜 헤더 값: no-store는 보고서·사례 내용이 캐시에 남지 않게, CSP는 인라인/외부 스크립트 차단(ADR 0006). 값은 그대로 옮겼다.
(secure) {
	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}
}

# 왜 8080 고정: 워크스페이스 규약(비특권 포트, 호스트 포트는 Docker가 배정).
:8080 {
	log {
		output stdout
		format console
	}

	@health path /healthz /readyz
	handle @health {
		header Content-Type application/json
		respond `{"status":"ok"}` 200
	}

	@unsafe not method GET HEAD
	handle @unsafe {
		import secure
		respond 405
	}

	handle {
		import secure
		root * /srv
		file_server
	}

	handle_errors {
		import secure
		respond "not found" {err.status_code}
	}
}
